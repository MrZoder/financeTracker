# Where Trajectory stores its embedded PostgreSQL (PGlite) database.
# Defaults to <home>/.trajectory/db — outside OneDrive so the DB isn't locked mid-write.
# TRAJECTORY_DATA_DIR=C:\Users\you\.trajectory\db

# Hosted deployments (Vercel etc.) need a real PostgreSQL. Free option: https://neon.tech
# Use the pooled connection string. Tables are created automatically on first start.
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Optional: protect the app with a passphrase (recommended if exposed beyond localhost).
# TRAJECTORY_PASSPHRASE=change-me
# TRAJECTORY_SESSION_SECRET=long-random-string

# Timezone used to decide what "today" is. Defaults to Australia/Sydney.
# TRAJECTORY_TIMEZONE=Australia/Sydney

# Seed the fictional demo dataset when the database is empty.
# Defaults to true in development and false in production.
# TRAJECTORY_SEED_DEMO=true

# Freeze "today" for demos/tests (YYYY-MM-DD).
# TRAJECTORY_TODAY_OVERRIDE=2026-09-19
